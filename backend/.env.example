FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
# Comma-separated list of origins allowed to call the API (Angular dev server by default)
CORS_ORIGINS=http://localhost:4200
HOST=127.0.0.1
PORT=5000

# Database (defaults to local SQLite)
DATABASE_URL=sqlite:///app.db

# Run pipelines in a background thread (HTTP 202 + UI polling). Set false to block until finished.
PIPELINE_ASYNC=true

# AI provider: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
